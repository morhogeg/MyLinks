{
  "manifest_version": 3,
  "name": "Machina: one-click save",
  "short_name": "Machina",
  "description": "Save any page, link, or selection to your Machina library in one click.",
  "version": "1.2.0",
  "homepage_url": "https://mymachina.app",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save to Machina",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolbar16.png",
      "24": "icons/toolbar24.png",
      "32": "icons/toolbar32.png"
    }
  },
  "options_ui": {
    "page": "popup.html?view=settings",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus", "storage", "notifications", "scripting"],
  "content_scripts": [
    {
      "matches": ["https://mymachina.app/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["connect.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save the current page to Machina"
    }
  }
}
