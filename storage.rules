rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deny everything to the client SDK. Nothing in the app reads or writes
    // Storage through the SDK (web/lib/firebase.ts initialises it and nothing
    // imports it; the Swift targets have no FirebaseStorage): every stored
    // image is served by its `firebaseStorageDownloadTokens` URL, which the
    // server mints (main._store_image) and which bypasses these rules, and
    // every write is Admin SDK. The old `screenshots/{uid}` read arm compared
    // the AUTH uid to the DATA uid, which differ for the phone-keyed
    // workspace, so it never matched a real reader anyway. Keep this file
    // deployed: it is what refuses a tokenless `alt=media` read.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
