out/
# Regenerable and large: `npm run score` rewrites it byte-identically (the synth
# is seeded), so the 12MB wav does not belong in git.
public/score.wav
# The reel's captures of the real app (~150MB of PNGs): regenerated from the
# app itself by `npm run reel:app && npm run reel:capture`, which is also what
# keeps the reel from drifting away from the shipped UI.
public/reel/
# Regenerable like score.wav (`npm run reel:score` rewrites it byte-identically).
public/reel-score.wav
